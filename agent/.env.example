# --- CodeHouse Prospecting Agent (copy to .env and fill) ---

# Banco de estado (padrão Millani: PostgreSQL). Em dev/dry-run use sqlite:
# CODEHOUSE_DB_URL=sqlite:///./codehouse.db
CODEHOUSE_DB_URL=postgresql+psycopg://user:pass@localhost:5432/codehouse

# n8n webhook que recebe a mensagem já redigida e dispara no WhatsApp (Meta Cloud API)
N8N_WEBHOOK_URL=https://seu-n8n.exemplo/webhook/codehouse-outbound

# n8n webhook que recebe respostas inbound do WhatsApp e grava no DB
N8N_INBOUND_WEBHOOK_URL=https://seu-n8n.exemplo/webhook/codehouse-inbound

# LLM (endpoint OpenAI-compatible). Em dev use FakeLLM (dry_run=true) sem credencial.
CODEHOUSE_LLM_BASE_URL=https://api.openai.com/v1
CODEHOUSE_LLM_API_KEY=
CODEHOUSE_LLM_MODEL=gpt-4o-mini

# Google Calendar (opcional). dry_run=true cria evento fake.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Apify (MCP/API) para descoberta de leads
APIFY_TOKEN=

# Modo seguro: true = não envia nada, usa fontes fake
CODEHOUSE_DRY_RUN=true
